{
  "name": "HansVanEijsden/radio-station-rds-extension",
  "type": "wordpress-plugin",
  "description": "Extends Radio Station plugin with FM-RDS-PTY and FM-RDS-PTYN taxonomies",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/phpstan": "^1.10",
    "phpstan/extension-installer": "^1.3",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "squizlabs/php_codesniffer": "^3.9"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "phpcs": "phpcs --standard=WordPress --ignore=vendor/*,node_modules/*,languages/* --extensions=php .",
    "phpcbf": "phpcbf --standard=WordPress --ignore=vendor/*,node_modules/*,languages/* --extensions=php .",
    "phpstan": "phpstan analyse --level=1 --memory-limit=2G .",
    "phpstan-max": "phpstan analyse --level=5 --memory-limit=2G ."
  }
}